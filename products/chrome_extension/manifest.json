{
  "manifest_version": 3,
  "name": "SynapseGEO — AI Search & Schema Auditor",
  "version": "1.0.0",
  "description": "Instant GEO audit for any webpage. Check ChatGPT, Perplexity & Google AI Overview citation readiness.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SynapseGEO Instant Auditor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
