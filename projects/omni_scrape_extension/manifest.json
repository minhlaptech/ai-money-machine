{
  "manifest_version": 3,
  "name": "OmniScrape AI — 1-Click Web Data to Excel & CSV",
  "short_name": "OmniScrape",
  "version": "1.0.0",
  "description": "Instantly extract tables, product lists, directories, emails, and phone numbers from any webpage into Excel, CSV, or Google Sheets.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "OmniScrape AI — Extract Data"
  },
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
