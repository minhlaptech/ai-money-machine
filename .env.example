# ==============================================================================
# AI MONEY MACHINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Hướng dẫn: Copy file này thành `.env` và điền các giá trị thực tế của bạn.
# File `.env` đã được cấu hình trong `.gitignore` để KHÔNG BAO GIỜ bị lộ lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT & HOSTING (Vercel)
# ------------------------------------------------------------------------------
# Lấy tại: https://vercel.com/account/tokens
VERCEL_TOKEN=
# (Tuỳ chọn) Team Slug hoặc Team ID nếu dùng Team account (ví dụ: minh-lap)
VERCEL_ORG_ID=minh-lap
# (Tuỳ chọn) Project ID sau khi link project (sẽ được tự động điền khi chạy vercel link)
VERCEL_PROJECT_ID=

# ------------------------------------------------------------------------------
# 2. AI MODELS & APIs (Dùng cho Micro-SaaS tools, content bots, automation)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, Embeddings) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini API - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek API (Chi phí siêu rẻ cho crawler & draft) - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 3. PAYMENT & E-COMMERCE (Kiếm tiền thụ động & bán sản phẩm số)
# ------------------------------------------------------------------------------
# Lemon Squeezy - https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Gumroad - https://gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=

# Stripe (Tuỳ chọn nếu dùng trực tiếp) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. GITHUB & VERSION CONTROL
# ------------------------------------------------------------------------------
# Personal Access Token để tự động hoá CI/CD hoặc push - https://github.com/settings/tokens
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 5. EMAIL MARKETING & NOTIFICATIONS
# ------------------------------------------------------------------------------
# ConvertKit / Kit API Key - https://app.kit.com/account_settings/advanced_settings
CONVERTKIT_API_KEY=
# Hoặc Resend API Key để gửi email tự động - https://resend.com/api-keys
RESEND_API_KEY=

# Telegram Bot (Gửi thông báo có đơn hàng mới về điện thoại của bạn)
# Tạo bot qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
